# Copia este archivo a `.env` y reemplaza los valores marcados como OBLIGATORIO.
# `.env` está en .gitignore: nunca subas credenciales reales al repositorio.

# --- PostgreSQL (cola de jobs y estado del hub) ---
POSTGRES_DB=erpsynchub
POSTGRES_USER=erpsynchub
# OBLIGATORIO
POSTGRES_PASSWORD=
# Puerto expuesto en el host
POSTGRES_PORT=5432

# --- SAP simulado (SapB1.Mock) ---
# Puerto expuesto en el host (dentro del contenedor escucha en 8080)
SAP_MOCK_PORT=5100

# --- Tienda WooCommerce (perfil `tienda`, opcional) ---
# Puerto expuesto en el host
WP_PORT=8081
# OBLIGATORIO al usar el perfil `tienda`
WP_DB_PASSWORD=
WP_ADMIN_USER=admin
# OBLIGATORIO al usar el perfil `tienda`
WP_ADMIN_PASSWORD=
WP_ADMIN_EMAIL=admin@example.com

# --- Hub (se exportan como variables de entorno al ejecutar dotnet run; Docker Compose no las usa) ---
# Database__ConnectionString=Host=localhost;Port=5432;Database=erpsynchub;Username=erpsynchub;Password=<POSTGRES_PASSWORD>
# Database__MigrateOnStartup=true
# Secreto compartido con el webhook de WooCommerce (mínimo 16 caracteres). OBLIGATORIO
# Webhooks__WooCommerce__Secret=
