# Copia este archivo a `.env` y reemplaza los valores marcados como OBLIGATORIO.
# `.env` está en .gitignore: nunca subas credenciales reales al repositorio.

# --- PostgreSQL (cola de jobs y estado del hub) ---
POSTGRES_DB=erpsynchub
POSTGRES_USER=erpsynchub
# OBLIGATORIO
POSTGRES_PASSWORD=
# Puerto expuesto en el host
POSTGRES_PORT=5432

# --- SAP simulado (SapB1.Mock) ---
# Puerto expuesto en el host (dentro del contenedor escucha en 8080)
SAP_MOCK_PORT=5100

# --- Tienda WooCommerce (perfil `tienda`, opcional) ---
# Puerto expuesto en el host
WP_PORT=8081
# OBLIGATORIO al usar el perfil `tienda`
WP_DB_PASSWORD=
WP_ADMIN_USER=admin
# OBLIGATORIO al usar el perfil `tienda`
WP_ADMIN_PASSWORD=
WP_ADMIN_EMAIL=admin@example.com

# --- Hub en Docker (perfil `hub`) y webhook de la tienda hacia el hub ---
# Secreto compartido del webhook (mínimo 16 caracteres): lo usan el hub y el webhook que crea `tienda-setup`. OBLIGATORIO
WC_WEBHOOK_SECRET=
# Puerto del hub expuesto en el host
HUB_PORT=5191
# URL a la que WooCommerce envía los webhooks. Por defecto, el hub de Compose; con el hub en el host: http://host.docker.internal:5191/webhooks/woocommerce/orders
HUB_WEBHOOK_URL=http://hub:8080/webhooks/woocommerce/orders
# Credenciales de SAP que usa el hub de Compose (por defecto, las del SAP simulado)
SAP_COMPANY_DB=SBODemoCL
SAP_USER_NAME=manager
SAP_PASSWORD=manager

# --- Hub (se exportan como variables de entorno al ejecutar dotnet run; Docker Compose no las usa) ---
# Database__ConnectionString=Host=localhost;Port=5432;Database=erpsynchub;Username=erpsynchub;Password=<POSTGRES_PASSWORD>
# Database__MigrateOnStartup=true
# Secreto compartido con el webhook de WooCommerce (mínimo 16 caracteres). OBLIGATORIO
# Webhooks__WooCommerce__Secret=
# SAP (Service Layer). Con el SAP simulado de Compose: http://localhost:5100, SBODemoCL, manager, manager
# SAP__BaseUrl=http://localhost:5100
# SAP__CompanyDb=SBODemoCL
# SAP__UserName=manager
# SAP__Password=
