# Copia este archivo a `.env` y reemplaza los valores marcados como OBLIGATORIO.
# `.env` está en .gitignore: nunca subas credenciales reales al repositorio.

# --- PostgreSQL (cola de jobs y estado del hub) ---
POSTGRES_DB=erpsynchub
POSTGRES_USER=erpsynchub
# OBLIGATORIO
POSTGRES_PASSWORD=
# Puertos publicados en el host (solo en 127.0.0.1). Entre contenedores se usan el nombre del servicio y su puerto interno.
# Si alguno está ocupado por otro proyecto, cámbialo aquí. Ver cuál lo usa: Get-NetTCPConnection -LocalPort 5433
POSTGRES_HOST_PORT=5433

# --- SAP simulado (SapB1.Mock) ---
SAP_MOCK_HOST_PORT=5201

# --- Tienda WooCommerce (perfil `tienda`, opcional) ---
TIENDA_HOST_PORT=5203
# OBLIGATORIO al usar el perfil `tienda`
WP_DB_PASSWORD=
WP_ADMIN_USER=admin
# OBLIGATORIO al usar el perfil `tienda`
WP_ADMIN_PASSWORD=
WP_ADMIN_EMAIL=admin@example.com

# --- Hub en Docker Compose (parte del entorno por defecto) y webhook de la tienda hacia el hub ---
# Secreto compartido del webhook (mínimo 16 caracteres): lo usan el hub y el webhook que crea `tienda-setup`. OBLIGATORIO para levantar el hub
WC_WEBHOOK_SECRET=
HUB_HOST_PORT=5200
# URL a la que WooCommerce envía los webhooks. Por defecto, el hub de Compose; con el hub en el host (dotnet run, puerto 5210): http://host.docker.internal:5210/webhooks/woocommerce/orders
HUB_WEBHOOK_URL=http://hub:8080/webhooks/woocommerce/orders
# Credenciales de SAP que usa el hub de Compose (por defecto, las del SAP simulado)
SAP_COMPANY_DB=SBODemoCL
SAP_USER_NAME=manager
SAP_PASSWORD=manager

# --- Hub (se exportan como variables de entorno al ejecutar dotnet run; Docker Compose no las usa) ---
# Database__ConnectionString=Host=localhost;Port=5433;Database=erpsynchub;Username=erpsynchub;Password=<POSTGRES_PASSWORD>
# Database__MigrateOnStartup=true
# Secreto compartido con el webhook de WooCommerce (mínimo 16 caracteres). OBLIGATORIO
# Webhooks__WooCommerce__Secret=
# SAP (Service Layer). Con el SAP simulado de Compose: http://localhost:5201, SBODemoCL, manager, manager
# SAP__BaseUrl=http://localhost:5201
# SAP__CompanyDb=SBODemoCL
# SAP__UserName=manager
# SAP__Password=
# Formato del RUT en FederalTaxID: WithDots (12.345.678-5, por defecto) o WithoutDots (12345678-5).
# Debe coincidir con cómo guarda el RUT su SAP: la búsqueda es estricta en ese formato.
# SAP__TaxIdFormat=WithDots

# --- Seq: visor de logs estructurados (solo desarrollo local, sin autenticación) ---
# Interfaz web: http://localhost:5202
SEQ_HOST_PORT=5202
# Para enviar los logs de un hub que corre en el host (dotnet run) a Seq; sin esta variable solo se escribe en consola.
# Seq__ServerUrl=http://localhost:5202
# Seq__ApiKey=
